# Homeiffy LLC - environment variables
# Copy to .env.local for local development.
# Set the same variables in Vercel Project Settings for deployment.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# Site environment
# -----------------------------------------------------------------------------
# staging = Stripe test mode, noindex, full functional testing, fulfilment blocked
# production = live sales (requires verified catalog, policies, and credentials)
NEXT_PUBLIC_SITE_ENV=staging

# Public site URL (Stripe redirect URLs, canonical links, OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Contact / notifications
# -----------------------------------------------------------------------------
# Recipient for contact form, quote requests, and internal order notifications.
# Do not invent an email - use the business-approved address only.
CONTACT_EMAIL=

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Server secret key - NEVER expose to the client bundle
# Use sk_test_* in staging; sk_live_* only when NEXT_PUBLIC_SITE_ENV=production
STRIPE_SECRET_KEY=

# Publishable key (optional; for client-side Stripe.js if extended)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret for POST /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Enable Stripe Tax automatic calculation at checkout (true/false)
STRIPE_TAX_ENABLED=false

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sender domain in Resend
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Optional Supabase (production persistence)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
