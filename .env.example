# Homeiffy LLC - environment variables
# Copy to .env.local for local development.
# Set the same variables in Vercel Project Settings for deployment.
# Never commit real secrets.
#
# ─────────────────────────────────────────────────────────────────────────────
# GO-LIVE CHECKLIST
# The catalog, policies and site content are complete in the repository. The
# five variables marked REQUIRED below are the only things standing between
# this build and taking real orders.
# ─────────────────────────────────────────────────────────────────────────────

# -----------------------------------------------------------------------------
# Site environment
# -----------------------------------------------------------------------------
# production = live sales, search engines allowed, Stripe live keys expected
# staging    = Stripe test mode, noindex, safe for client review
NEXT_PUBLIC_SITE_ENV=production

# REQUIRED. Public site URL, no trailing slash.
# Used for canonical links, OG metadata, the sitemap and Stripe redirect URLs.
# Getting this wrong sends customers to the wrong host after payment.
NEXT_PUBLIC_SITE_URL=https://homeiffy.com

# -----------------------------------------------------------------------------
# Contact / notifications
# -----------------------------------------------------------------------------
# REQUIRED. Recipient for contact form, quote requests and order notifications.
# This address is also published in the Privacy Policy, Terms, Shipping Policy,
# Return Policy, Accessibility Statement and FAQ, so it must be a real inbox
# that someone monitors. Until it is set, those pages fall back to
# support@homeiffy.com, which must exist or be changed here.
CONTACT_EMAIL=

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# REQUIRED. Server secret key - NEVER expose to the client bundle.
# Use sk_test_* while NEXT_PUBLIC_SITE_ENV=staging, sk_live_* for production.
STRIPE_SECRET_KEY=

# Publishable key (optional; for client-side Stripe.js if extended)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# REQUIRED. Webhook signing secret for POST /api/webhooks/stripe.
# Without it, payment confirmations cannot be verified and orders will not be
# marked paid. Create the endpoint in the Stripe dashboard pointing at
# https://<your-domain>/api/webhooks/stripe and copy the whsec_* value here.
STRIPE_WEBHOOK_SECRET=

# Enable Stripe Tax automatic calculation at checkout (true/false).
# Turn on once nexus and tax registration are configured in Stripe.
STRIPE_TAX_ENABLED=false

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# REQUIRED. Without it, customers receive no order confirmation.
RESEND_API_KEY=
# REQUIRED. Must be a verified sender domain in Resend, e.g. orders@homeiffy.com
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Optional Supabase (production order persistence)
# -----------------------------------------------------------------------------
# Without these, orders persist to a local .data/orders.json file store, which
# is fine for a single instance but will not survive a serverless redeploy.
# Configure Supabase before relying on order history at scale.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
